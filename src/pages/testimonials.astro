---
import Layout from '../layouts/Layout.astro'
import { SITE, SERVICES } from '../lib/site.js'

// No client testimonials yet. Populate each group below with real quotes (client first
// name/initial, service used, short quote, location/transaction type if they're comfortable
// sharing) as they come in — do not add placeholder or fabricated reviews before then.
---

<Layout
  title="Testimonials"
  description={`Client testimonials for ${SITE.agentName}'s flat-fee FSBO services in ${SITE.areaSentence}.`}
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-heading text-3xl text-brand">What clients say</h1>
    <p class="mt-4 text-stone-600">
      Thomas Roberts is building his FSBO client base in {SITE.addressLocality} and the
      surrounding area — check back soon for client stories.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        SERVICES.map((service) => (
          <div class="rounded-lg border border-dashed border-stone-300 p-6">
            <h2 class="font-semibold text-stone-900">{service.name}</h2>
            <p class="mt-2 text-sm text-stone-500">
              No client stories for {service.name.toLowerCase()} yet — this space is reserved
              for the first one.
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 rounded-lg bg-stone-50 p-6 text-center">
      <p class="text-stone-700">Worked with {SITE.agentName} already?</p>
      <a href="/get-started" class="mt-3 inline-block font-medium text-gold-dark">
        Share your experience &rarr;
      </a>
    </div>
  </section>
</Layout>
