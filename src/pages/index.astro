---
import Layout from '../layouts/Layout.astro'
import { Image, getImage } from 'astro:assets'
import JsonLd from '../components/JsonLd.astro'
import heroPhoto from '../assets/first-time-home-hero.webp'
import { SITE, SERVICES } from '../lib/site.js'

const heroAlt = `Modern craftsman-style home with white board-and-batten siding, stone accents, and a dark garage door, landscaped front yard, and blue sky, representing homes for first-time buyers in ${SITE.areaSentence}`
const heroOptimized = await getImage({ src: heroPhoto, format: 'webp', width: 1600 })
const heroSchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  contentUrl: new URL(heroOptimized.src, SITE.url).href,
  name: 'Home for first-time buyers in Southeast Idaho',
  description: heroAlt,
  contentLocation: SITE.areaSentence,
  creator: { '@type': 'RealEstateAgent', name: SITE.agentName },
}
---

<Layout
  title="First-Time Home Buyer Help in Southeast Idaho"
  description={`Thomas Roberts is a licensed real estate agent who guides first-time home buyers in ${SITE.areaSentence} from budget and pre-approval through home search, offer, and closing.`}
>
  <Fragment slot="head">
    <JsonLd data={heroSchema} />
  </Fragment>

  <section class="relative overflow-hidden bg-brand py-20 text-center text-white">
    <Image
      src={heroPhoto}
      alt={heroAlt}
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-brand-dark/55" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-6 [text-shadow:0_1px_8px_rgba(0,0,0,0.55)]">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">
        First-Time Home Buyers
      </p>
      <h1 class="mt-4 font-heading text-[clamp(1.5rem,5vw,3rem)] leading-tight">
        Buying Your First Home?<br />
        Get a Guide Who <em class="font-heading font-medium not-italic text-gold italic">Explains Every Step</em>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-stone-200">
        {SITE.agentName} is a licensed real estate agent in Idaho Falls, Idaho who helps
        first-time home buyers understand the process and buy with confidence — from budget and
        pre-approval through home search, offer, inspection, and closing.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/get-started"
          class="rounded-md bg-gold px-6 py-3 font-semibold text-brand-dark hover:bg-gold-dark"
        >
          Get Started
        </a>
        <a
          href="/what-i-offer"
          class="rounded-md border border-white/40 px-6 py-3 font-semibold text-white hover:border-white"
        >
          See How I Help
        </a>
      </div>
      <p class="mt-6 text-stone-200">
        New to buying a home?{' '}
        <a href="/get-started" class="font-medium text-gold underline">
          Book your free first-time buyer consultation
        </a>{' '}
        — a free online call, no obligation.
      </p>
      <p class="mt-6 text-sm text-stone-300">{SITE.areaSentence}</p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-dark">Why Work With Me</p>
      <h2 class="mt-2 font-heading text-2xl text-brand sm:text-3xl">
        Your First Home Purchase Shouldn't Feel Like Guesswork
      </h2>
      <p class="mt-4 text-stone-600">
        Buying a first home means new vocabulary, big deadlines, and a lot of paperwork.
        {SITE.agentName} explains each step in plain language, tells you what to expect next, and
        keeps you on track so you can make decisions without feeling rushed or lost.
      </p>
      <a href="/first-time-buyers" class="mt-4 inline-block text-sm font-medium text-gold-dark">
        Read the first-time buyer guide &rarr;
      </a>
    </div>
  </section>

  <section class="bg-stone-50 py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="text-center font-heading text-2xl text-brand sm:text-3xl">How I Help</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          SERVICES.map((service) => (
            <div class="rounded-lg border border-stone-200 bg-white p-5">
              <h3 class="font-semibold text-stone-900">{service.name}</h3>
              <p class="mt-2 text-sm text-stone-600">{service.homeTeaser}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-8 text-center">
        <a href="/what-i-offer" class="text-sm font-medium text-gold-dark">
          See the full buying process &rarr;
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16 text-center">
    <h2 class="font-heading text-2xl text-brand">Licensed, Local, and Direct</h2>
    <p class="mt-4 text-stone-600">
      {SITE.agentName} holds an active Idaho real estate license and works with {SITE.brokerage}, serving {SITE.areaSentence}.
    </p>
  </section>

  <section class="bg-brand py-16 text-white">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="font-heading text-2xl">Not sure where to start?</h2>
      <p class="mt-2 text-stone-200">
        Book a free consultation — no pressure, no obligation.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/get-started" class="text-sm font-medium text-gold">Get started &rarr;</a>
        <a href="/faq" class="text-sm font-medium text-gold">Browse the FAQ &rarr;</a>
      </div>
    </div>
  </section>
</Layout>
