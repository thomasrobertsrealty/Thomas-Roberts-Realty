---
import Layout from '../layouts/Layout.astro'
import { Image, getImage } from 'astro:assets'
import JsonLd from '../components/JsonLd.astro'
import heroPhoto from '../assets/fsbo-home-hero.jpg'
import { SITE, SERVICES } from '../lib/site.js'

const heroAlt = `Modern craftsman-style home with white board-and-batten siding, stone accents, and a dark garage door, with a red and white For Sale By Owner yard sign on the lawn, representing FSBO homes in ${SITE.areaSentence}`
const heroOptimized = await getImage({ src: heroPhoto, format: 'webp', width: 1600 })
const heroSchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  contentUrl: new URL(heroOptimized.src, SITE.url).href,
  name: 'For Sale By Owner home in Southeast Idaho',
  description: heroAlt,
  contentLocation: SITE.areaSentence,
  creator: { '@type': 'RealEstateAgent', name: SITE.agentName },
}
---

<Layout
  title="Flat-Fee For Sale By Owner (FSBO) Real Estate Help"
  description={`Thomas Roberts offers flat-fee support for For Sale By Owner (FSBO) sellers and buyers in ${SITE.areaSentence} — choose only what you need from contract review, marketing, open houses, and market data.`}
>
  <Fragment slot="head">
    <JsonLd data={heroSchema} />
  </Fragment>

  <section class="relative overflow-hidden bg-brand py-20 text-center text-white">
    <Image
      src={heroPhoto}
      alt={heroAlt}
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-brand-dark/30" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-6 [text-shadow:0_1px_8px_rgba(0,0,0,0.55)]">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">
        Flat-Fee FSBO Support
      </p>
      <h1 class="mt-4 whitespace-nowrap font-heading text-[clamp(1.1rem,4.8vw,3rem)] leading-tight">
        Sell or Buy Without an Agent —<br />
        Get Only the <em class="font-heading font-medium not-italic text-gold italic">Help You Actually Need</em>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-stone-200">
        {SITE.agentName} is a licensed real estate agent in Idaho Falls, Idaho who offers
        flat-fee support for FSBO sellers and buyers — choose only what you need from contract
        review, marketing, open houses, and market data, priced individually instead of a full
        commission.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/get-started"
          class="rounded-md bg-gold px-6 py-3 font-semibold text-brand-dark hover:bg-gold-dark"
        >
          Get Started
        </a>
        <a
          href="/what-i-offer"
          class="rounded-md border border-white/40 px-6 py-3 font-semibold text-white hover:border-white"
        >
          See What I Offer
        </a>
      </div>
      <p class="mt-6 text-stone-200">
        New to For Sale By Owner?
        <a href="/get-started" class="font-medium text-gold underline">
          Book your free For Sale By Owner consultation
        </a>
        — a free online call, no obligation.
      </p>
      <p class="mt-6 text-sm text-stone-300">{SITE.areaSentence}</p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-dark">Why For Sale By Owner</p>
      <h2 class="mt-2 font-heading text-2xl text-brand sm:text-3xl">
        You Shouldn't Pay for a Bundle You Don't Need
      </h2>
      <p class="mt-4 text-stone-600">
        Full-service agents charge commission for a bundle of services most FSBO sellers don't
        want or need all of. Instead of paying a percentage of the sale price for a full-service
        agent, FSBO sellers and buyers can hire {SITE.agentName} for just the specific parts of
        the transaction where they want expert help.
      </p>
      <a href="/fsbo-help" class="mt-4 inline-block text-sm font-medium text-gold-dark">
        See how this compares to hiring an attorney or flat-fee MLS company &rarr;
      </a>
    </div>
  </section>

  <section class="bg-stone-50 py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="text-center font-heading text-2xl text-brand sm:text-3xl">What I Offer</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          SERVICES.map((service) => (
            <div class="rounded-lg border border-stone-200 bg-white p-5">
              <h3 class="font-semibold text-stone-900">{service.name}</h3>
              <p class="mt-2 text-sm text-stone-600">{service.homeTeaser}</p>
              <p class="mt-2 text-sm font-medium text-gold-dark">{service.priceLabel}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-8 text-center">
        <a href="/what-i-offer" class="text-sm font-medium text-gold-dark">
          See all services and pick what fits &rarr;
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16 text-center">
    <h2 class="font-heading text-2xl text-brand">Licensed, Local, and Direct</h2>
    <p class="mt-4 text-stone-600">
      {SITE.agentName} holds an active Idaho real estate license and works with {SITE.brokerage}, serving {SITE.areaSentence}.
    </p>
  </section>

  <section class="bg-brand py-16 text-white">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="font-heading text-2xl">Not sure what you need?</h2>
      <p class="mt-2 text-stone-200">
        See what fits your situation — no pressure, no obligation.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/get-started" class="text-sm font-medium text-gold">Get started &rarr;</a>
        <a href="/faq" class="text-sm font-medium text-gold">Browse the FAQ &rarr;</a>
      </div>
    </div>
  </section>
</Layout>
