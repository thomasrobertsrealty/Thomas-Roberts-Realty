---
import Layout from '../layouts/Layout.astro'
import { SITE } from '../lib/site.js'

const steps = [
  {
    title: 'Free home valuation',
    body: 'A walkthrough and a comparative market analysis based on recent, truly comparable sales in your neighborhood — not an automated estimate.',
  },
  {
    title: 'Prep and staging guidance',
    body: 'Practical, budget-aware recommendations on what to fix, clean, or stage — and what to skip.',
  },
  {
    title: 'Pricing strategy',
    body: 'Pricing set to attract strong offers quickly, based on current Southeast Idaho buyer demand.',
  },
  {
    title: 'Marketing and listing',
    body: 'Professional photos, a compelling listing description, and distribution across the MLS and major listing sites.',
  },
  {
    title: 'Offers and negotiation',
    body: `I'll walk you through every offer — price, terms, and contingencies — so you understand the full picture before you decide.`,
  },
  {
    title: 'Closing',
    body: 'Coordination with the buyer\'s agent, title company, and inspectors to keep the transaction on schedule.',
  },
]
---

<Layout
  title="Selling a Home"
  description={`A step-by-step guide to selling a home in Southeast Idaho with ${SITE.agentName}, ${SITE.brokerage}.`}
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-heading text-3xl text-brand">Selling a home in Southeast Idaho</h1>
    <p class="mt-4 text-stone-600">
      Here's how {SITE.agentName} approaches getting your home sold — for the right price, on
      your timeline.
    </p>

    <ol class="mt-10 space-y-8">
      {
        steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-brand text-sm font-semibold text-white">
              {i + 1}
            </span>
            <div>
              <h2 class="font-semibold text-stone-900">{step.title}</h2>
              <p class="mt-1 text-sm text-stone-600">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 rounded-lg bg-stone-50 p-6 text-center">
      <p class="text-stone-700">Curious what your home is worth in today's market?</p>
      <a href="/contact" class="mt-3 inline-block font-medium text-gold-dark"
        >Request a home valuation &rarr;</a
      >
    </div>
  </section>
</Layout>
