---
import Layout from '../layouts/Layout.astro'
import { SITE } from '../lib/site.js'

const steps = [
  {
    title: 'Get pre-approved',
    body: 'Before touring homes, connect with a lender to understand your budget. A pre-approval letter makes your offers stronger in a competitive market.',
  },
  {
    title: 'Define what you need',
    body: `We'll talk through must-haves versus nice-to-haves — neighborhood, school district, commute, lot size — so we only tour homes worth your time.`,
  },
  {
    title: 'Tour homes with local context',
    body: 'You get more than a walkthrough: notes on the neighborhood, resale considerations, and anything worth flagging before you fall in love with a house.',
  },
  {
    title: 'Make a competitive offer',
    body: 'Pricing strategy based on comparable sales in that specific Southeast Idaho market, not a generic formula.',
  },
  {
    title: 'Inspection, appraisal, and closing',
    body: `I'll coordinate with your lender, the inspector, and the title company, and walk you through every document before closing day.`,
  },
]
---

<Layout
  title="Buying a Home"
  description={`A step-by-step guide to buying a home in Southeast Idaho with ${SITE.agentName}, ${SITE.brokerage}.`}
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-bold text-stone-900">Buying a home in Southeast Idaho</h1>
    <p class="mt-4 text-stone-600">
      Here's what working with {SITE.agentName} looks like, from first conversation to keys in
      hand.
    </p>

    <ol class="mt-10 space-y-8">
      {
        steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-emerald-700 text-sm font-semibold text-white">
              {i + 1}
            </span>
            <div>
              <h2 class="font-semibold text-stone-900">{step.title}</h2>
              <p class="mt-1 text-sm text-stone-600">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 rounded-lg bg-stone-50 p-6 text-center">
      <p class="text-stone-700">Ready to start looking, or just have questions?</p>
      <a href="/contact" class="mt-3 inline-block font-medium text-emerald-700"
        >Get in touch &rarr;</a
      >
    </div>
  </section>
</Layout>
