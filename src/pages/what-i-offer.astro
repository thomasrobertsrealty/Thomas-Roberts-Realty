---
import Layout from '../layouts/Layout.astro'
import JsonLd from '../components/JsonLd.astro'
import { SITE, SERVICES } from '../lib/site.js'

const serviceSchemas = SERVICES.map((service) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.name,
  name: `${service.name} — ${SITE.agentName}`,
  description: service.offerSentence,
  provider: {
    '@type': 'RealEstateAgent',
    name: SITE.agentName,
  },
  areaServed: SITE.areaSentence,
}))
---

<Layout
  title="How I Help First-Time Home Buyers"
  description={`How ${SITE.agentName} guides first-time home buyers in ${SITE.areaSentence}: a free consultation, home search and tours, offers and negotiation, and support from contract to closing.`}
>
  <Fragment slot="head">
    {serviceSchemas.map((schema) => <JsonLd data={schema} />)}
  </Fragment>

  <section class="bg-brand py-12 text-center text-white">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">How I Help</p>
    <h1 class="mt-3 font-heading text-3xl sm:text-4xl">Guidance From First Call to Closing Day</h1>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <p class="text-lg text-stone-700">
      Thomas Roberts guides first-time home buyers in {SITE.areaSentence} through four stages:
      a free buyer consultation, home search and tours, offers and negotiation, and support from
      contract to closing.
    </p>

    <div class="mt-12 space-y-10">
      {
        SERVICES.map((service, i) => (
          <div class="border-b border-stone-200 pb-8 last:border-0">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-dark">Step {i + 1}</p>
            <h2 class="mt-1 font-heading text-xl text-brand">{service.name}</h2>
            <p class="mt-2 text-stone-600">{service.offerSentence}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-6 text-sm text-stone-500">
      Thomas is not an attorney or a lender. For legal questions, ask a real estate attorney; for
      loan options, talk with a mortgage lender.
    </p>
  </section>

  <section class="bg-stone-50 py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="font-heading text-2xl text-brand">Ready to talk it through?</h2>
      <p class="mt-2 text-stone-600">
        Start with a free consultation. There's no obligation, and you can ask anything.
      </p>
      <a href="/get-started" class="mt-4 inline-block font-medium text-gold-dark">
        Book your free first-time buyer consultation &rarr;
      </a>
      <p class="mt-8 text-stone-700">Want the full picture of how buying a home works?</p>
      <a href="/first-time-buyers" class="mt-3 inline-block font-medium text-gold-dark">
        Read the first-time buyer guide &rarr;
      </a>
    </div>
  </section>
</Layout>
