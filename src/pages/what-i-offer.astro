---
import Layout from '../layouts/Layout.astro'
import JsonLd from '../components/JsonLd.astro'
import ServiceSelector from '../components/ServiceSelector.jsx'
import { SITE, SERVICES } from '../lib/site.js'

// Service schema per offering, including real flat-fee pricing. Open Houses is billed hourly
// with a minimum, so it uses a UnitPriceSpecification instead of a flat Offer price.
const serviceSchemas = SERVICES.map((service) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.name,
  name: `${service.name} — ${SITE.agentName}`,
  description: service.offerSentence,
  provider: {
    '@type': 'RealEstateAgent',
    name: SITE.agentName,
  },
  areaServed: SITE.areaSentence,
  offers:
    service.pricingModel === 'hourly'
      ? {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'UnitPriceSpecification',
            price: service.hourlyRate,
            priceCurrency: 'USD',
            unitText: 'HOUR',
            eligibleQuantity: {
              '@type': 'QuantitativeValue',
              minValue: service.minimumHours,
              unitCode: 'HUR',
            },
          },
        }
      : {
          '@type': 'Offer',
          price: service.priceValue,
          priceCurrency: 'USD',
        },
}))
---

<Layout
  title="What I Offer"
  description={`Flat-fee services for FSBO sellers and buyers with ${SITE.agentName}: contract help, marketing, open houses, and market data — pick only what you need.`}
>
  <Fragment slot="head">
    {serviceSchemas.map((schema) => <JsonLd data={schema} />)}
  </Fragment>

  <section class="bg-brand py-12 text-center text-white">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">What I Offer</p>
    <h1 class="mt-3 font-heading text-3xl sm:text-4xl">Pick Only the Help You Need</h1>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <p class="text-lg text-stone-700">
      Thomas Roberts offers four services to FSBO sellers and buyers, available individually or
      together at a flat rate: Contract Help ($1,999 flat), Marketing ($499 flat), Market Data
      ($150 flat), and Open Houses ($65/hour, 2-hour minimum).
    </p>

    <div class="mt-12 space-y-10">
      {
        SERVICES.map((service) => (
          <div class="border-b border-stone-200 pb-8 last:border-0">
            <h2 class="font-heading text-xl text-brand">
              {service.name} — <span class="text-gold-dark">{service.priceLabelFull}</span>
            </h2>
            <p class="mt-2 text-stone-600">{service.offerSentence}</p>
            {service.note && <p class="mt-2 text-sm text-stone-500">{service.note}</p>}
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-stone-50 py-16">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="font-heading text-2xl text-brand">Choose what fits your situation</h2>
      <p class="mt-2 text-stone-600">
        Select any combination of services below. Selecting Contract Help locks in the full
        transaction scope described above — everything else can be mixed and matched.
      </p>
      <div class="mt-8 rounded-xl bg-white p-6 shadow-sm">
        <ServiceSelector client:load />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16 text-center">
    <p class="text-stone-700">
      Wondering why this beats hiring an attorney, a flat-fee MLS company, and a title company
      separately?
    </p>
    <a href="/fsbo-help" class="mt-3 inline-block font-medium text-gold-dark">
      See the comparison &rarr;
    </a>
    <p class="mt-8 text-stone-700">Not sure yet which services make sense for you?</p>
    <a href="/get-started" class="mt-3 inline-block font-medium text-gold-dark">
      Tell me what you need &rarr;
    </a>
  </section>
</Layout>
