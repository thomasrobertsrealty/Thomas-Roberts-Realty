---
import Layout from '../layouts/Layout.astro'
import JsonLd from '../components/JsonLd.astro'
import SourceLinks from '../components/SourceLinks.astro'
import { SITE } from '../lib/site.js'
import { SRC } from '../lib/sources.js'

const agent = SITE.agentName
const area = SITE.areaSentence

// Everything here is repeated from claims already made and sourced elsewhere on the site
// (the first-time buyer guide and the FAQ). Do not add dollar amounts or timelines without a source.
const stages = [
  {
    title: 'Home inspection',
    body: 'After the seller accepts your offer, a home inspection checks the home’s condition. You can negotiate repairs based on what the inspection finds.',
  },
  {
    title: 'Appraisal',
    body: 'The lender orders an appraisal to check the home’s value before it finishes your loan.',
  },
  {
    title: 'Closing documents',
    body: 'The title company prepares the closing documents while the inspection, appraisal, and loan work are finished.',
  },
  {
    title: 'Closing day',
    body: 'You sign the final paperwork at the title company and bring your closing funds. After that, the home is yours and you get the keys.',
  },
]

const faqs = [
  {
    q: 'What are closing costs when buying a home in Idaho?',
    blocks: [
      {
        text: 'Closing costs are the fees you pay to finish the purchase, separate from your down payment. The Consumer Financial Protection Bureau groups them into lender charges, optional points that lower your rate, required third-party services such as the appraisal and title insurance, local government fees, and prepaid items and deposits such as interest, the first year of homeowners insurance, and starting escrow deposits for property taxes and insurance.',
        sources: [SRC.cfpbClosingCosts],
      },
    ],
  },
  {
    q: 'Is the home inspection part of closing costs?',
    blocks: [
      {
        text: 'No. The home inspection and real estate agent fees are not required by the mortgage, so the CFPB lists them as other homebuying expenses. Plan for them in addition to your closing costs.',
        sources: [SRC.cfpbClosingCosts],
      },
    ],
  },
  {
    q: 'How can I find out what my closing costs will be?',
    blocks: [
      {
        text: `Your lender must give you a Loan Estimate within three business days of receiving your application. It shows estimated closing costs, the monthly payment, and the interest rate on a standard form, so you can compare lenders side by side. Bring yours to your consultation with ${agent}.`,
        sources: [SRC.cfpbLoanEstimate],
      },
    ],
  },
  {
    q: 'Can down payment assistance help with closing costs in Idaho?',
    blocks: [
      {
        text: 'Idaho Housing’s down payment assistance can go toward closing costs for eligible buyers. It is a second mortgage, so it adds a small monthly payment.',
        sources: [SRC.idahoHousingDpa],
      },
    ],
  },
  {
    q: 'What happens between an accepted offer and closing day?',
    blocks: [
      {
        text: `You complete a home inspection, the lender orders an appraisal, and the title company prepares closing documents. ${agent} coordinates the deadlines and explains each step so nothing is missed.`,
      },
    ],
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.blocks.map((b) => b.text).join(' '),
    },
  })),
}
---

<Layout
  title="Closing Costs, Inspection, and Appraisal for First-Time Buyers in Idaho"
  description={`What closing costs cover, how the home inspection and appraisal fit in, and what happens from accepted offer to closing day, explained for first-time buyers in ${area}.`}
>
  <Fragment slot="head">
    <JsonLd data={faqSchema} />
  </Fragment>

  <section class="bg-brand py-12 text-center text-white">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">First-Time Buyers</p>
    <h1 class="mt-3 font-heading text-3xl sm:text-4xl">
      Closing Costs, Inspection, and Appraisal for First-Time Buyers
    </h1>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <p class="text-lg text-stone-700">
      After your offer is accepted, four things happen before you get the keys: a home inspection,
      the lender’s appraisal, closing documents from the title company, and closing day. You also
      need cash for closing costs, on top of your down payment.
    </p>
    <p class="mt-4 text-stone-600">
      {agent} is a licensed Idaho real estate agent with {SITE.brokerage}, helping first-time buyers
      in {area}. He is not a lender or an attorney, so confirm cost details with your lender.
    </p>
  </section>

  <section class="bg-stone-50 py-16">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="font-heading text-2xl text-brand">From Accepted Offer to Closing Day</h2>
      <ol class="mt-8 space-y-6">
        {
          stages.map((stage, i) => (
            <li class="flex gap-4">
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-gold font-semibold text-brand-dark">
                {i + 1}
              </span>
              <div>
                <h3 class="font-semibold text-stone-900">{stage.title}</h3>
                <p class="mt-1 text-stone-600">{stage.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <h2 class="font-heading text-2xl text-brand">Closing Costs and Inspection: Common Questions</h2>
    <div class="mt-8 space-y-8">
      {
        faqs.map((item) => (
          <div>
            <h3 class="font-semibold text-stone-900">{item.q}</h3>
            {item.blocks.map((block) => (
              <Fragment>
                <p class="mt-2 text-stone-600">{block.text}</p>
                {block.sources && <SourceLinks sources={block.sources} />}
              </Fragment>
            ))}
          </div>
        ))
      }
    </div>
    <p class="mt-8 text-stone-600">
      Closing costs are only part of the cash you need. See how loan types change the down payment in
      the
      <a href="/first-time-buyer-loans-idaho" class="font-medium text-gold-dark underline">first-time buyer loans guide</a>,
      or read
      <a href="/how-much-house-can-i-afford-idaho" class="font-medium text-gold-dark underline">how much house you can afford in Idaho</a>.
    </p>
  </section>

  <section class="bg-gold/10 py-16">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="font-heading text-2xl text-brand">Talk Through the Closing Process With {agent}</h2>
      <p class="mt-4 text-stone-600">
        In a free 20 to 30 minute video call, {agent} can walk through what to expect from accepted
        offer to keys. There is no obligation.
      </p>
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        <a href="/get-started" class="font-medium text-gold-dark">
          Book your free first-time buyer consultation &rarr;
        </a>
        <a href="/first-time-buyers" class="font-medium text-gold-dark">
          Read the first-time buyer guide &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>
