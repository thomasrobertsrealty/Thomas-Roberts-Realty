---
import Layout from '../layouts/Layout.astro'
import GetStartedForm from '../components/GetStartedForm.jsx'
import { SITE } from '../lib/site.js'
---

<Layout
  title="Get Started"
  description={`Tell ${SITE.agentName} what you need help with as a For Sale By Owner (FSBO) seller or buyer in ${SITE.areaSentence} — flat-fee contract help, marketing, open houses, and market data.`}
>
  <section class="mx-auto grid max-w-5xl gap-12 px-6 py-16 sm:grid-cols-2">
    <div>
      <h1 class="font-heading text-3xl text-brand">Get started</h1>
      <p class="mt-4 text-stone-600">
        Thomas Roberts offers flat-fee real estate services for For Sale By Owner (FSBO) sellers and buyers in {SITE.areaSentence} — choose only the help you need: contract review, marketing, open
        houses, or market data. Answer a few quick questions below and Thomas will follow up to
        go over flat-fee options for exactly what you're looking for.
      </p>

      <dl class="mt-8 space-y-3 text-sm">
        <div>
          <dt class="font-medium text-stone-900">Phone</dt>
          <dd><a href={`tel:${SITE.phoneRaw}`} class="text-gold-dark">{SITE.phone}</a></dd>
        </div>
        <div>
          <dt class="font-medium text-stone-900">Email</dt>
          <dd><a href={`mailto:${SITE.email}`} class="text-gold-dark">{SITE.email}</a></dd>
        </div>
        <div>
          <dt class="font-medium text-stone-900">Brokerage</dt>
          <dd>{SITE.brokerage}</dd>
        </div>
      </dl>

      <p class="mt-6 text-sm text-stone-500">{SITE.responseCommitment}</p>
    </div>

    <div>
      <GetStartedForm client:load />
    </div>
  </section>
</Layout>
