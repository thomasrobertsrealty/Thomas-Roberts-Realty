---
import Layout from '../layouts/Layout.astro'
import GetStartedForm from '../components/GetStartedForm.jsx'
import { SITE } from '../lib/site.js'
---

<Layout
  title="Get Started"
  description={`Book a free For Sale By Owner consultation with ${SITE.agentName}, or request flat-fee contract help, marketing, open houses, and market data in ${SITE.areaSentence}.`}
>
  <section class="border-b border-gold/30 bg-gold/10 py-10">
    <div class="mx-auto max-w-5xl px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-dark">Free consultation</p>
      <h2 class="mt-2 font-heading text-2xl text-brand">Free For Sale By Owner consultation</h2>
      <p class="mt-3 text-stone-700">
        Thomas Roberts offers a free For Sale By Owner consultation in Idaho Falls, Rexburg, Rigby, Ammon, Shelley, Blackfoot, and surrounding areas that explains what selling or buying without an agent involves, with no obligation to hire him.
      </p>
      <p class="mt-3 text-stone-600">
        In 20 to 30 minutes, Thomas covers the marketing work, the contract paperwork, open house logistics, and pricing. Afterward you can handle everything yourself or hire him for only the parts you don't want to do.
      </p>
      <p class="mt-3 text-sm text-stone-500">
        Thomas is not an attorney, so questions of law are best directed to a real estate attorney.
      </p>
      <a href="#get-started-form" class="mt-4 inline-block font-medium text-gold-dark">
        Book your free For Sale By Owner consultation &darr;
      </a>
    </div>
  </section>

  <section class="mx-auto grid max-w-5xl gap-12 px-6 py-16 sm:grid-cols-2">
    <div>
      <h1 class="font-heading text-3xl text-brand">Get started</h1>
      <p class="mt-4 text-stone-600">
        Thomas Roberts offers flat-fee real estate services for For Sale By Owner (FSBO) sellers and buyers in {SITE.areaSentence} — choose only the help you need: contract review, marketing, open
        houses, or market data. Answer a few quick questions below and Thomas will follow up to
        go over flat-fee options for exactly what you're looking for.
      </p>

      <dl class="mt-8 space-y-3 text-sm">
        <div>
          <dt class="font-medium text-stone-900">Phone</dt>
          <dd><a href={`tel:${SITE.phoneRaw}`} class="text-gold-dark">{SITE.phone}</a></dd>
        </div>
        <div>
          <dt class="font-medium text-stone-900">Email</dt>
          <dd><a href={`mailto:${SITE.email}`} class="text-gold-dark">{SITE.email}</a></dd>
        </div>
        <div>
          <dt class="font-medium text-stone-900">Brokerage</dt>
          <dd>{SITE.brokerage}</dd>
        </div>
      </dl>

      <p class="mt-6 text-sm text-stone-500">{SITE.responseCommitment}</p>
    </div>

    <div id="get-started-form">
      <GetStartedForm client:load />
    </div>
  </section>
</Layout>
