---
import Layout from '../layouts/Layout.astro'
import JsonLd from '../components/JsonLd.astro'
import SourceLinks from '../components/SourceLinks.astro'
import { SITE } from '../lib/site.js'
import { SRC, uniqueSources } from '../lib/sources.js'

const agent = SITE.agentName
const area = SITE.areaSentence

// Every figure below comes from the pages listed in each row's sources. Programs change, so the
// page tells readers to confirm details with a lender.
const loanRows = [
  {
    loan: 'Conventional',
    down: 'As low as 3% for eligible buyers. Putting 20% down generally avoids mortgage insurance.',
    who: 'Fannie Mae HomeReady and Freddie Mac Home Possible allow 3% down for households at or under 80% of the area median income. Fannie Mae also allows 3% down on a standard loan if at least one borrower is a first-time buyer. HomeReady requires a credit score of 620.',
    watch:
      'Mortgage insurance is typically required with under 20% down, but on HomeReady and Home Possible it can be cancelled once your equity reaches 20%. Homeownership education may be required if every borrower is a first-time buyer.',
    sources: [SRC.fannieHomeReady, SRC.fannie97, SRC.freddieHomePossible, SRC.cfpbMortgageInsurance],
  },
  {
    loan: 'FHA',
    down: 'As low as 3.5% of the purchase price.',
    who: 'HUD says FHA loans offer lower down payments and are a good option for first-time buyers.',
    watch:
      'FHA mortgage insurance is required on all FHA loans, with an upfront cost that can be rolled into the loan and a monthly cost.',
    sources: [SRC.hudFha, SRC.hudBuying, SRC.cfpbMortgageInsurance],
  },
  {
    loan: 'VA',
    down: 'No down payment as long as the sales price is not higher than the home’s appraised value.',
    who: 'Eligible veterans and service members who qualify for a VA Certificate of Eligibility and meet VA and lender standards for credit and income.',
    watch: 'You may owe a one-time VA funding fee, and you must plan to live in the home.',
    sources: [SRC.vaPurchase],
  },
  {
    loan: 'USDA',
    down: 'None required. Loans can cover 100% of the appraised value.',
    who: 'Households with income within 115% of the area median income, buying a modest primary residence in an eligible rural area.',
    watch:
      'As of USDA’s January 2026 overview: a 1% upfront guarantee fee and a 0.35% annual fee. Check whether a specific address is eligible before you fall in love with it.',
    sources: [SRC.usdaGuaranteed, SRC.usdaEligibility],
  },
]

const idahoHousingBullets = [
  'Household income must be at or below $170,000, and some loan programs require lower income.',
  'You do not have to be a first-time buyer.',
  'You must sign up for the Finally Home! homebuyer education course.',
  'You must work with a lender that Idaho Housing has approved.',
  'The assistance is a second mortgage, so it adds a small monthly payment.',
]

const faqs = [
  {
    q: 'What loans can a first-time buyer use in Idaho?',
    a: `First-time buyers in Idaho commonly use conventional, FHA, VA, or USDA loans. Idaho Housing and Finance Association also offers loan programs for each of those types through approved lenders. Down payment, credit expectations, and mortgage insurance differ between them. ${agent} can explain how they compare, and a mortgage lender can tell you which one fits your numbers.`,
    sources: [SRC.idahoHousingHomebuyers, SRC.hudFha, SRC.vaPurchase, SRC.usdaGuaranteed, SRC.fannieHomeReady],
  },
  {
    q: 'How much do I need for a down payment in Idaho?',
    a: 'It depends on the loan. Conventional loans can start at 3% down for eligible buyers, FHA loans start at 3.5%, and VA and USDA loans can require nothing down for eligible buyers. Idaho Housing also offers down payment assistance of up to 8% of the sales price, and buyers contribute a minimum of $500 of their own funds. You should still budget for closing costs and a home inspection.',
    sources: [SRC.fannieHomeReady, SRC.hudFha, SRC.vaPurchase, SRC.usdaGuaranteed, SRC.idahoHousingDpa],
  },
  {
    q: 'Does Idaho have down payment assistance for first-time buyers?',
    a: 'Yes. Idaho Housing and Finance Association offers down payment assistance of up to 8% of the home’s sales price toward the down payment and closing costs. Household income must be at or below $170,000, and some loan programs require lower income. Buyers must sign up for the Finally Home! homebuyer education course and work with an Idaho Housing approved lender. The assistance is a second mortgage, so it adds a small monthly payment.',
    sources: [SRC.idahoHousingDpa],
  },
  {
    q: 'Do I have to be a first-time buyer to use Idaho Housing down payment assistance?',
    a: 'No. Idaho Housing says its down payment assistance is open to eligible Idaho homebuyers, not only first-time buyers.',
    sources: [SRC.idahoHousingDpa],
  },
  {
    q: 'Is a USDA loan available in Idaho Falls, Rexburg, Rigby, Ammon, Shelley, or Blackfoot?',
    a: 'It depends on the specific property address. USDA loans require the home to be in an eligible rural area, and you can check an address on the USDA eligibility website. Household income must also be within the USDA limit for the area.',
    sources: [SRC.usdaEligibility, SRC.usdaGuaranteed],
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
}

// The full list at the bottom is built from every source cited above, so nothing cited inline can be missing.
const allSources = uniqueSources(
  loanRows.flatMap((r) => r.sources),
  [SRC.idahoHousingDpa, SRC.idahoHousingHomebuyers],
  faqs.flatMap((f) => f.sources)
)
---

<Layout
  title="First-Time Buyer Loans and Down Payment Help in Idaho"
  description={`Compare conventional, FHA, VA, and USDA loans and Idaho Housing down payment assistance for first-time buyers in ${area}, with links to the official sources.`}
>
  <Fragment slot="head">
    <JsonLd data={faqSchema} />
  </Fragment>

  <section class="bg-brand py-12 text-center text-white">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">First-Time Buyers</p>
    <h1 class="mt-3 font-heading text-3xl sm:text-4xl">
      First-Time Buyer Loans and Down Payment Help in Idaho
    </h1>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <p class="text-lg text-stone-700">
      Most first-time buyers in Idaho choose between four loan types: conventional, FHA, VA, and
      USDA. Idaho Housing and Finance Association adds down payment assistance on top. Here is how
      they compare, in plain language, with a link to the official source for each claim.
    </p>
    <p class="mt-4 text-stone-600">
      {agent} is a licensed Idaho real estate agent with {SITE.brokerage}, helping first-time buyers
      in {area}. He is not a lender, so confirm every detail below with a mortgage lender before you
      decide. The sources were checked in November 2026, and programs change.
    </p>
  </section>

  <section class="bg-stone-50 py-16">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-heading text-2xl text-brand">Loan Types Compared</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <caption class="sr-only">First-time buyer loan types compared by down payment, who it fits, what to watch for, and sources</caption>
          <thead class="bg-stone-100 text-stone-900">
            <tr>
              <th scope="col" class="border border-stone-200 px-3 py-2 font-semibold">Loan</th>
              <th scope="col" class="border border-stone-200 px-3 py-2 font-semibold">Down payment</th>
              <th scope="col" class="border border-stone-200 px-3 py-2 font-semibold">Who it fits</th>
              <th scope="col" class="border border-stone-200 px-3 py-2 font-semibold">What to watch for</th>
              <th scope="col" class="border border-stone-200 px-3 py-2 font-semibold">Sources</th>
            </tr>
          </thead>
          <tbody class="bg-white align-top text-stone-600">
            {
              loanRows.map((row) => (
                <tr>
                  <th scope="row" class="border border-stone-200 px-3 py-2 font-medium text-stone-900">
                    {row.loan}
                  </th>
                  <td class="border border-stone-200 px-3 py-2">{row.down}</td>
                  <td class="border border-stone-200 px-3 py-2">{row.who}</td>
                  <td class="border border-stone-200 px-3 py-2">{row.watch}</td>
                  <td class="border border-stone-200 px-3 py-2">
                    <SourceLinks sources={row.sources} stacked />
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-stone-500">
        Lenders can set their own requirements on top of these program rules, so your lender may ask
        for more.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <h2 class="font-heading text-2xl text-brand">Idaho Housing Down Payment Assistance</h2>
    <p class="mt-4 text-stone-600">
      Idaho Housing and Finance Association offers down payment assistance that can cover up to 8%
      of the home’s sales price toward the down payment and closing costs. Buyers contribute a
      minimum of $500 of their own funds.
    </p>
    <ul class="mt-4 list-disc space-y-2 pl-6 text-stone-600">
      {idahoHousingBullets.map((b) => <li>{b}</li>)}
    </ul>
    <SourceLinks sources={SRC.idahoHousingDpa} />
    <p class="mt-4 text-stone-600">
      Idaho Housing also offers its own loans, and says a credit score of 620 or greater is
      beneficial. Those loans and the assistance both go through lenders Idaho Housing has approved.
    </p>
    <SourceLinks sources={SRC.idahoHousingHomebuyers} />
    <p class="mt-4 text-sm text-stone-500">
      These details were taken from Idaho Housing’s website in November 2026. Limits and rates
      change, so check their site or ask an approved lender for current numbers.
    </p>
  </section>

  <section class="bg-stone-50 py-16">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="font-heading text-2xl text-brand">Check Your Numbers First</h2>
      <p class="mt-4 text-stone-600">
        The down payment is only part of the cash you need. Use the free home buying calculator
        (you log in or create a free account) to estimate a monthly payment and see what to do
        before you buy, or read how lenders decide how much you can borrow. Your loan can also
        narrow your choice of town, since USDA loans only work for eligible addresses.
      </p>
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        <a href="/my-plan" class="font-medium text-gold-dark">
          Open the home buying calculator (free account) &rarr;
        </a>
        <a href="/how-much-house-can-i-afford-idaho" class="font-medium text-gold-dark">
          How much house can I afford? &rarr;
        </a>
        <a href="/first-time-buyer-areas-southeast-idaho" class="font-medium text-gold-dark">
          Compare towns near Idaho Falls &rarr;
        </a>
        <a href="/closing-costs-and-inspection-idaho" class="font-medium text-gold-dark">
          Closing costs and inspection &rarr;
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <h2 class="font-heading text-2xl text-brand">First-Time Buyer Loan Questions in Idaho</h2>
    <div class="mt-8 space-y-8">
      {
        faqs.map((item) => (
          <div>
            <h3 class="font-semibold text-stone-900">{item.q}</h3>
            <p class="mt-2 text-stone-600">{item.a}</p>
            <SourceLinks sources={item.sources} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-gold/10 py-16">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="font-heading text-2xl text-brand">Talk It Through With {agent}</h2>
      <p class="mt-4 text-stone-600">
        {agent} offers first-time buyers a free 20 to 30 minute video call on Google Meet to talk
        through the buying process, your budget, and what to do first. There is no obligation.
      </p>
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        <a href="/get-started" class="font-medium text-gold-dark">
          Book your free first-time buyer consultation &rarr;
        </a>
        <a href="/first-time-buyers" class="font-medium text-gold-dark">
          Read the first-time buyer guide &rarr;
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-12">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-stone-500">All sources on this page</h2>
    <ul class="mt-3 space-y-1 text-sm">
      {
        allSources.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-gold-dark underline">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
