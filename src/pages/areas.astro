---
import Layout from '../layouts/Layout.astro'
import { SITE, AREAS } from '../lib/site.js'
---

<Layout
  title="Areas Served"
  description={`${SITE.agentName} serves buyers and sellers across Southeast Idaho, including Idaho Falls, Pocatello, Rexburg, Ammon, Blackfoot, and Chubbuck.`}
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-bold text-stone-900">Areas served in Southeast Idaho</h1>
    <p class="mt-4 text-stone-600">
      {SITE.agentName} works with buyers and sellers throughout Southeast Idaho. Each market has
      its own character — here's a quick look at each.
    </p>

    <div class="mt-10 space-y-10">
      {
        AREAS.map((area) => (
          <div id={area.slug} class="border-b border-stone-200 pb-8 last:border-0">
            <h2 class="text-xl font-semibold text-stone-900">{area.name}, Idaho</h2>
            <p class="mt-2 text-stone-600">{area.blurb}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 rounded-lg bg-stone-50 p-6 text-center">
      <p class="text-stone-700">Don't see your area listed? Reach out — chances are it's still in range.</p>
      <a href="/contact" class="mt-3 inline-block font-medium text-emerald-700">Ask a question &rarr;</a>
    </div>
  </section>
</Layout>
