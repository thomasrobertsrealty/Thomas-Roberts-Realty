---
import Layout from '../layouts/Layout.astro'
import JsonLd from '../components/JsonLd.astro'
import SourceLinks from '../components/SourceLinks.astro'
import { SITE } from '../lib/site.js'
import { SRC } from '../lib/sources.js'

const faqs = [
  {
    q: 'I have never bought a home. Where do I start?',
    a: `Start with a free buyer consultation. ${SITE.agentName} walks you through the buying process, your budget, and pre-approval, then helps you with home search, offers, and closing at your pace.`,
  },
  {
    q: 'Do I need to be pre-approved before I look at homes?',
    a: 'It is strongly recommended. A pre-approval is a statement from a mortgage lender that they are tentatively willing to lend you money, up to a certain amount, and sellers often want to see one before they accept an offer. It is based on assumptions and is not a guaranteed loan. Thomas can explain the process, but he is not a lender, so the pre-approval itself comes from a lender.',
    sources: [SRC.cfpbPreapproval],
    more: { href: '/how-much-house-can-i-afford-idaho', label: 'How much house can I afford in Idaho?' },
  },
  {
    q: 'How much do I need for a down payment?',
    a: 'It depends on the loan type. Conventional loans can start at 3% down for eligible buyers, FHA loans start at 3.5%, and VA and USDA loans can require no down payment for eligible buyers. Idaho Housing also offers down payment assistance of up to 8% of the sales price for eligible buyers. A lender can tell you what applies to you. Also plan for closing costs and the cost of a home inspection.',
    sources: [SRC.fannieHomeReady, SRC.hudFha, SRC.vaPurchase, SRC.usdaGuaranteed, SRC.idahoHousingDpa],
    more: { href: '/first-time-buyer-loans-idaho', label: 'Compare first-time buyer loans in Idaho' },
  },
  {
    q: 'Which town is best for a first-time buyer near Idaho Falls?',
    a: 'It depends on your budget, commute, and the kind of home you want. Idaho Falls and Ammon offer the shortest trips to jobs and shopping, Rigby, Shelley, and Blackfoot can offer more land or a lower price for a longer drive, and Rexburg suits buyers tied to BYU-Idaho. The town comparison page walks through what to check in each.',
    more: { href: '/first-time-buyer-areas-southeast-idaho', label: 'Compare towns near Idaho Falls' },
  },
  {
    q: 'What does the process look like from offer to closing?',
    a: 'After your offer is accepted, you complete a home inspection, the lender orders an appraisal, and the title company prepares closing documents. Thomas coordinates the deadlines and explains each step so nothing is missed.',
    more: { href: '/closing-costs-and-inspection-idaho', label: 'Closing costs, inspection, and appraisal explained' },
  },
  {
    q: 'What does it cost to work with Thomas?',
    a: 'The initial consultation is free with no obligation. Under rules that took effect August 17, 2024, an agent working with a buyer must have a written agreement before touring a home, and it has to state the agent’s compensation as a specific amount or rate. Broker fees and commissions are not set by law and are negotiable. Thomas will explain how his compensation works when you talk, before you agree to anything.',
    sources: [SRC.narSettlement],
  },
  {
    q: 'Is there a free first-time buyer consultation?',
    a: `Yes. ${SITE.agentName} offers a free 20 to 30 minute first-time buyer consultation, held as an online video call on Google Meet, for buyers in ${SITE.areaSentence}. He walks you through the buying process, budgeting, pre-approval, and what to do first. There is no obligation. He is not an attorney or a lender, so legal and loan questions should go to those professionals. Request it on the Get Started page.`,
  },
  {
    q: 'Is Thomas Roberts a licensed real estate agent?',
    a: `Yes. ${SITE.agentName} is a licensed real estate agent in Idaho with ${SITE.brokerage}.`,
  },
  {
    q: 'What areas does he serve?',
    a: `${SITE.agentName} serves ${SITE.areaSentence}.`,
  },
  {
    q: 'How do I get started?',
    a: 'Visit the Get Started page and answer a few quick questions about what you are looking for. Thomas will follow up to talk through next steps.',
  },
  {
    q: 'How quickly does Thomas respond after I reach out?',
    a: SITE.responseCommitment,
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
}
---

<Layout
  title="Frequently Asked Questions"
  description={`Answers to common first-time home buyer questions about pre-approval, down payments, the offer-to-closing process, and working with ${SITE.agentName} in ${SITE.areaSentence}.`}
>
  <Fragment slot="head">
    <JsonLd data={faqSchema} />
  </Fragment>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-heading text-3xl text-brand">Frequently asked questions</h1>
    <p class="mt-4 text-stone-600">
      Thomas Roberts helps first-time home buyers in {SITE.areaSentence} understand the buying
      process, from budget and pre-approval through home search, offer, and closing.
    </p>

    <div class="mt-10 space-y-8">
      {
        faqs.map((item) => (
          <div>
            <h2 class="font-semibold text-stone-900">{item.q}</h2>
            <p class="mt-2 text-stone-600">{item.a}</p>
            {item.sources && <SourceLinks sources={item.sources} />}
            {item.more && (
              <p class="mt-2 text-sm">
                <a href={item.more.href} class="font-medium text-gold-dark underline">{item.more.label} &rarr;</a>
              </p>
            )}
          </div>
        ))
      }
    </div>

    <div class="mt-12 rounded-lg bg-gold/10 p-6 text-center">
      <a href="/get-started" class="font-medium text-gold-dark">
        Book your free first-time buyer consultation &rarr;
      </a>
    </div>

    <div class="mt-6 rounded-lg bg-stone-50 p-6 text-center">
      <p class="text-stone-700">Want a step-by-step look at buying your first home?</p>
      <a href="/first-time-buyers" class="mt-3 inline-block font-medium text-gold-dark">Read the first-time buyer guide &rarr;</a>
    </div>

    <div class="mt-6 rounded-lg bg-stone-50 p-6 text-center">
      <p class="text-stone-700">Wondering what you can afford, comparing loans, or choosing a town?</p>
      <a href="/how-much-house-can-i-afford-idaho" class="mt-3 inline-block font-medium text-gold-dark">How much house can I afford? &rarr;</a>
      <br />
      <a href="/first-time-buyer-loans-idaho" class="mt-3 inline-block font-medium text-gold-dark">Compare first-time buyer loans in Idaho &rarr;</a>
      <br />
      <a href="/first-time-buyer-areas-southeast-idaho" class="mt-3 inline-block font-medium text-gold-dark">Compare towns near Idaho Falls &rarr;</a>
      <br />
      <a href="/closing-costs-and-inspection-idaho" class="mt-2 inline-block font-medium text-gold-dark">Closing costs, inspection, and appraisal &rarr;</a>
    </div>

    <div class="mt-6 rounded-lg bg-stone-50 p-6 text-center">
      <p class="text-stone-700">Don't see your question here?</p>
      <a href="/get-started" class="mt-3 inline-block font-medium text-gold-dark">Ask directly &rarr;</a>
    </div>
  </section>
</Layout>
