---
import Layout from '../layouts/Layout.astro'
import JsonLd from '../components/JsonLd.astro'
import { SITE, SERVICES } from '../lib/site.js'

const priceBySlug = Object.fromEntries(SERVICES.map((s) => [s.slug, s.priceLabelFull]))

const faqs = [
  {
    q: 'What does it cost to work with Thomas instead of a traditional agent?',
    a: `${SITE.agentName} charges a flat fee per service instead of a commission on the sale price: Contract Help is ${priceBySlug['contract-help']}, Marketing is ${priceBySlug['marketing']}, Market Data is ${priceBySlug['market-data']}, and Open Houses is ${priceBySlug['open-houses']}. Total cost depends on which services you select, not on your home's sale price.`,
  },
  {
    q: 'Do I have to use all the services, or can I pick just one?',
    a: 'You can choose any combination of marketing, open houses, and market data individually. Contract help, if selected, covers the full transaction rather than select documents.',
  },
  {
    q: "Why can't I get help with just some of the contract paperwork?",
    a: 'Partial contract review creates liability and coverage gaps, so once you choose contract help, Thomas handles every document in your transaction from offer through closing — that way nothing falls through the cracks and no paperwork is left half-reviewed.',
  },
  {
    q: 'Am I still selling my home myself if I use these services?',
    a: `Yes. You stay in control of showings and the sale, and ${SITE.agentName} fills in specific gaps with the services you select.`,
  },
  {
    q: "What's the difference between this and just hiring a full-service agent?",
    a: 'No commission on the sale price, no bundled services you don’t want, and direct flat-fee pricing for only the help you choose.',
  },
  {
    q: 'Is Thomas Roberts a licensed real estate agent?',
    a: `Yes. ${SITE.agentName} is a licensed real estate agent in Idaho with ${SITE.brokerage}.`,
  },
  {
    q: 'What areas does he serve?',
    a: `${SITE.agentName} serves ${SITE.areaSentence}.`,
  },
  {
    q: 'How do I get started?',
    a: 'Visit the Get Started page and answer a few quick questions about what you need — Thomas will follow up to go over flat-fee options.',
  },
  {
    q: 'Can buyers use these services too, or is this seller-only?',
    a: 'Yes — the same flat-fee, pick-only-what-you-need services (contract help, marketing, open houses, market data) are available to FSBO buyers as well as sellers.',
  },
  {
    q: 'How quickly does Thomas respond after I reach out?',
    a: SITE.responseCommitment,
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
}
---

<Layout
  title="Frequently Asked Questions"
  description={`Answers to common FSBO questions about flat-fee contract help, marketing, open houses, and market data with ${SITE.agentName} in ${SITE.areaSentence}.`}
>
  <Fragment slot="head">
    <JsonLd data={faqSchema} />
  </Fragment>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-heading text-3xl text-brand">Frequently asked questions</h1>
    <p class="mt-4 text-stone-600">
      Thomas Roberts offers flat-fee real estate services for FSBO sellers and buyers in {SITE.areaSentence} — choose only the help you need from contract review, marketing, open
      houses, and market data.
    </p>

    <div class="mt-10 space-y-8">
      {
        faqs.map((item) => (
          <div>
            <h2 class="font-semibold text-stone-900">{item.q}</h2>
            <p class="mt-2 text-stone-600">{item.a}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 rounded-lg bg-stone-50 p-6 text-center">
      <p class="text-stone-700">
        Wondering who can help with a FSBO contract or MLS listing without a full agent?
      </p>
      <a href="/fsbo-help" class="mt-3 inline-block font-medium text-gold-dark">Visit FSBO Help &rarr;</a>
    </div>

    <div class="mt-6 rounded-lg bg-stone-50 p-6 text-center">
      <p class="text-stone-700">Don't see your question here?</p>
      <a href="/get-started" class="mt-3 inline-block font-medium text-gold-dark">Ask directly &rarr;</a>
    </div>
  </section>
</Layout>
