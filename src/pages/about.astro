---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import JsonLd from '../components/JsonLd.astro'
import { SITE } from '../lib/site.js'
import headshot from '../assets/thomas-roberts-headshot.jpg'

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.agentName,
  jobTitle: 'Real Estate Agent',
  worksFor: {
    '@type': 'RealEstateOrganization',
    name: SITE.brokerage,
  },
  telephone: SITE.phoneRaw,
  email: SITE.email,
  url: `${SITE.url}/about`,
}
---

<Layout
  title="About Me"
  description={`Meet ${SITE.agentName}, a licensed real estate agent with ${SITE.brokerage} offering flat-fee For Sale By Owner (FSBO) services in ${SITE.areaSentence}.`}
>
  <Fragment slot="head">
    <JsonLd data={personSchema} />
  </Fragment>

  <section class="bg-brand py-12 text-center text-white">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">About Thomas</p>
    <h1 class="mt-3 font-heading text-3xl sm:text-4xl">A Local Agent Built for FSBO</h1>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
      <Image
        src={headshot}
        alt={`${SITE.agentName}, licensed real estate agent with ${SITE.brokerage} in Idaho Falls, Idaho`}
        width={320}
        class="h-40 w-40 flex-shrink-0 rounded-full object-cover object-top"
      />
      <div class="space-y-4 text-stone-700">
        <p class="font-medium text-stone-900">
          {SITE.agentName} is a licensed real estate agent with {SITE.brokerage} based in
          Southeast Idaho, focused on helping For Sale By Owner (FSBO) sellers and buyers handle their own
          transactions with flat-fee support, letting them pick only the services they need
          instead of a traditional commission.
        </p>
        <p>
          Most FSBO sellers and buyers aren't against getting help — they're against paying a
          full commission for a bundle of services they don't all need. Thomas built his
          flat-fee model so FSBO clients can keep control of their own sale or purchase while
          filling in exactly where they're exposed, which is usually contracts and marketing
          reach.
        </p>
      </div>
    </div>

    <div class="mt-10 space-y-2 text-stone-700">
      <p>
        <strong>{SITE.agentName} serves {SITE.areaSentence}.</strong>
      </p>
      <ul class="space-y-2">
        <li>&bull; {SITE.licenseNumber} <span class="text-stone-400">[TODO: add license number]</span></li>
        <li>&bull; {SITE.brokerage}</li>
        <li>&bull; Flat-fee FSBO support: contract help, marketing, open houses, market data</li>
        <li>&bull; Works with both FSBO sellers and FSBO buyers</li>
      </ul>
    </div>

    <div class="mt-10 rounded-lg border border-stone-200 p-6">
      <p class="text-stone-700">
        Outside of real estate, I like being outdoors around Southeast Idaho as much as
        possible — it's a big part of why I like helping people stay local instead of getting
        priced out by fees that don't match what they actually need. If you're on the fence
        about doing this yourself, that's exactly the conversation I'd rather have with you
        before you commit to anything.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      <div class="rounded-lg border border-stone-200 p-5">
        <h2 class="font-heading text-brand">Brokerage</h2>
        <p class="mt-1 text-sm text-stone-600">{SITE.brokerage}</p>
      </div>
      <div class="rounded-lg border border-stone-200 p-5">
        <h2 class="font-heading text-brand">Service area</h2>
        <p class="mt-1 text-sm text-stone-600">{SITE.areaSentence}</p>
      </div>
    </div>

    <div class="mt-12 rounded-lg bg-stone-50 p-6 text-center">
      <p class="text-stone-700">See exactly what flat-fee help looks like.</p>
      <a href="/what-i-offer" class="mt-3 inline-block font-medium text-gold-dark">
        What I offer &rarr;
      </a>
    </div>
  </section>
</Layout>
