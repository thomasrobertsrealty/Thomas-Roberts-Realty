---
import Layout from '../layouts/Layout.astro'
import JsonLd from '../components/JsonLd.astro'
import { SITE } from '../lib/site.js'

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.agentName,
  jobTitle: 'Real Estate Agent',
  worksFor: {
    '@type': 'RealEstateOrganization',
    name: SITE.brokerage,
  },
  telephone: SITE.phoneRaw,
  email: SITE.email,
  url: `${SITE.url}/about`,
}
---

<Layout
  title="About"
  description={`Meet ${SITE.agentName}, a Southeast Idaho real estate agent with ${SITE.brokerage}.`}
>
  <Fragment slot="head">
    <JsonLd data={personSchema} />
  </Fragment>

  <section class="bg-brand py-12 text-center text-white">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">About Thomas</p>
    <h1 class="mt-3 font-heading text-3xl sm:text-4xl">A Local Agent Who Knows This Market</h1>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
      <div
        class="flex h-40 w-40 flex-shrink-0 items-center justify-center rounded-full bg-stone-100 text-center text-xs text-stone-400"
        role="img"
        aria-label="Placeholder for agent headshot photo"
      >
        [Add headshot photo]
      </div>
      <div class="space-y-4 text-stone-700">
        <p>
          I'm {SITE.agentName}, a licensed real estate agent with {SITE.brokerage}. I live and
          work right here in Southeast Idaho — which means I know the neighborhoods, the schools,
          and what buyers and sellers in this area actually care about.
        </p>
        <p>My goal is simple: give you straight answers, honest guidance, and make the process as smooth as possible. No pressure, no games.</p>
      </div>
    </div>

    <ul class="mt-10 space-y-2 text-stone-700">
      <li>&bull; {SITE.licenseNumber} <span class="text-stone-400">[TODO: add license number]</span></li>
      <li>&bull; Serving Idaho Falls, Rexburg, Rigby & surrounding communities</li>
      <li>&bull; {SITE.brokerage} — locally trusted brokerage</li>
      <li>&bull; Buyer and seller representation</li>
      <li>&bull; Free home valuations — no obligation</li>
    </ul>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      <div class="rounded-lg border border-stone-200 p-5">
        <h2 class="font-heading text-brand">Brokerage</h2>
        <p class="mt-1 text-sm text-stone-600">{SITE.brokerage}</p>
      </div>
      <div class="rounded-lg border border-stone-200 p-5">
        <h2 class="font-heading text-brand">Service area</h2>
        <p class="mt-1 text-sm text-stone-600">Southeast Idaho</p>
      </div>
    </div>
  </section>
</Layout>
