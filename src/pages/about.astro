---
import Layout from '../layouts/Layout.astro'
import JsonLd from '../components/JsonLd.astro'
import { SITE } from '../lib/site.js'

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.agentName,
  jobTitle: 'Real Estate Agent',
  worksFor: {
    '@type': 'RealEstateOrganization',
    name: SITE.brokerage,
  },
  telephone: SITE.phoneRaw,
  email: SITE.email,
  url: `${SITE.url}/about`,
}
---

<Layout
  title="About"
  description={`Meet ${SITE.agentName}, a Southeast Idaho real estate agent with ${SITE.brokerage}.`}
>
  <Fragment slot="head">
    <JsonLd data={personSchema} />
  </Fragment>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-bold text-stone-900">About {SITE.agentName}</h1>

    <div class="mt-8 flex flex-col gap-8 sm:flex-row sm:items-start">
      <div
        class="flex h-40 w-40 flex-shrink-0 items-center justify-center rounded-full bg-stone-100 text-center text-xs text-stone-400"
        role="img"
        aria-label="Placeholder for agent headshot photo"
      >
        [Add headshot photo]
      </div>
      <div class="space-y-4 text-stone-700">
        <p>
          {SITE.agentName} is a real estate agent with {SITE.brokerage}, serving buyers and
          sellers throughout Southeast Idaho — including Idaho Falls, Pocatello, Rexburg, Ammon,
          Blackfoot, and Chubbuck. [TODO: Replace with your real bio — background, how you got
          into real estate, and what you're known for locally.]
        </p>
        <p>
          {SITE.licenseNumber}. [TODO: Add years of experience, number of transactions closed,
          designations/certifications, or other credentials that build trust.]
        </p>
      </div>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      <div class="rounded-lg border border-stone-200 p-5">
        <h2 class="font-semibold text-stone-900">Brokerage</h2>
        <p class="mt-1 text-sm text-stone-600">{SITE.brokerage}</p>
      </div>
      <div class="rounded-lg border border-stone-200 p-5">
        <h2 class="font-semibold text-stone-900">Service area</h2>
        <p class="mt-1 text-sm text-stone-600">Southeast Idaho</p>
      </div>
    </div>
  </section>
</Layout>
