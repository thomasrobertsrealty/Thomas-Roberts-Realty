---
import Layout from '../layouts/Layout.astro'
import ContactForm from '../components/ContactForm.jsx'
import { SITE } from '../lib/site.js'
---

<Layout
  title="Contact"
  description={`Get in touch with ${SITE.agentName}, real estate agent with ${SITE.brokerage} serving Southeast Idaho.`}
>
  <section class="mx-auto grid max-w-5xl gap-12 px-6 py-16 sm:grid-cols-2">
    <div>
      <h1 class="font-heading text-3xl text-brand">Get in touch</h1>
      <p class="mt-4 text-stone-600">
        Whether you're ready to tour homes, curious what your property is worth, or just have a
        question about the Southeast Idaho market, reach out.
      </p>

      <dl class="mt-8 space-y-3 text-sm">
        <div>
          <dt class="font-medium text-stone-900">Phone</dt>
          <dd><a href={`tel:${SITE.phoneRaw}`} class="text-gold-dark">{SITE.phone}</a></dd>
        </div>
        <div>
          <dt class="font-medium text-stone-900">Email</dt>
          <dd><a href={`mailto:${SITE.email}`} class="text-gold-dark">{SITE.email}</a></dd>
        </div>
        <div>
          <dt class="font-medium text-stone-900">Brokerage</dt>
          <dd>{SITE.brokerage}</dd>
        </div>
      </dl>
    </div>

    <div>
      <ContactForm client:load />
    </div>
  </section>
</Layout>
