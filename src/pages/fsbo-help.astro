---
import Layout from '../layouts/Layout.astro'
import JsonLd from '../components/JsonLd.astro'
import { SITE, SERVICES } from '../lib/site.js'

const priceBySlug = Object.fromEntries(SERVICES.map((s) => [s.slug, s.priceLabelFull]))

const comparisonRows = [
  {
    need: 'Contract review/preparation',
    typical: 'Hire a real estate attorney separately',
    withThomas: `Available as a standalone service (${priceBySlug['contract-help']}, full transaction)`,
  },
  {
    need: 'MLS/Zillow/Realtor.com exposure',
    typical: 'Hire a flat-fee MLS company separately',
    withThomas: `Available as a standalone service (${priceBySlug['marketing']}) — direct MLS access as a licensed agent`,
  },
  {
    need: 'Open house coverage',
    typical: 'Usually self-run or not offered',
    withThomas: `Available hourly (${priceBySlug['open-houses']})`,
  },
  {
    need: 'Market pricing guidance',
    typical: 'Often not offered without a full agent',
    withThomas: `Available as a standalone service (${priceBySlug['market-data']})`,
  },
  {
    need: 'Number of providers to coordinate',
    typical: '2–3 separate businesses',
    withThomas: '1',
  },
]

const fsboFaqs = [
  {
    q: 'Who can help with a FSBO contract in Idaho Falls without hiring a full agent?',
    a: `${SITE.agentName} offers standalone contract help — reviewing and preparing all of the paperwork for a real estate transaction, from offer through closing, for ${priceBySlug['contract-help']} — with no requirement to hire him for anything else.`,
  },
  {
    q: 'Who can list my for-sale-by-owner property on the MLS in Southeast Idaho?',
    a: `Idaho's MLS is agent-only, so FSBO sellers need a licensed agent for direct MLS, Zillow, and Realtor.com exposure. ${SITE.agentName} offers this as a standalone marketing service for ${priceBySlug['marketing']}.`,
  },
  {
    q: 'Is there a flat-fee alternative to a full-service real estate agent in Idaho Falls, Rexburg, or Rigby?',
    a: `Yes. ${SITE.agentName} offers four services in ${SITE.areaSentence}, each available individually: contract help (${priceBySlug['contract-help']}), marketing (${priceBySlug['marketing']}), open houses (${priceBySlug['open-houses']}), and market data (${priceBySlug['market-data']}) — no full-service commission required.`,
  },
  {
    q: 'Do I need a real estate attorney to sell my house myself in Idaho?',
    a: `There is no legal requirement to hire an attorney to sell a home yourself in Idaho, but contract review is recommended. ${SITE.agentName} provides contract review as one of his standalone services instead of requiring a separate attorney.`,
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: fsboFaqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
}

const serviceSchemas = SERVICES.map((service) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.name,
  name: `${service.name} — ${SITE.agentName}`,
  description: service.offerSentence,
  provider: {
    '@type': 'RealEstateAgent',
    name: SITE.agentName,
  },
  areaServed: SITE.areaSentence,
  offers:
    service.pricingModel === 'hourly'
      ? {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'UnitPriceSpecification',
            price: service.hourlyRate,
            priceCurrency: 'USD',
            unitText: 'HOUR',
            eligibleQuantity: {
              '@type': 'QuantitativeValue',
              minValue: service.minimumHours,
              unitCode: 'HUR',
            },
          },
        }
      : {
          '@type': 'Offer',
          price: service.priceValue,
          priceCurrency: 'USD',
        },
}))
// Tiered services publish a price range instead of a single price.
serviceSchemas.forEach((schema, i) => {
  const service = SERVICES[i]
  if (service.pricingModel === 'tiered') {
    schema.offers = {
      '@type': 'AggregateOffer',
      lowPrice: service.priceValue,
      highPrice: service.priceHigh,
      priceCurrency: 'USD',
      offerCount: service.tiers.length,
    }
  }
})
---

<Layout
  title="For Sale By Owner (FSBO) Help"
  description={`Flat-fee, individually priced help for For Sale By Owner (FSBO) sellers and buyers in ${SITE.areaSentence} — contract review, MLS marketing, open houses, and market data from one licensed agent instead of separate providers.`}
>
  <Fragment slot="head">
    <JsonLd data={faqSchema} />
    {serviceSchemas.map((schema) => <JsonLd data={schema} />)}
  </Fragment>

  <section class="bg-brand py-12 text-center text-white">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">FSBO Help</p>
    <h1 class="mt-3 font-heading text-3xl sm:text-4xl">For Sale By Owner: Selling or Buying Without an Agent?</h1>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <p class="text-lg text-stone-700">
      Thomas Roberts provides flat-fee support for For Sale By Owner (FSBO) sellers and buyers
      in {SITE.areaSentence} — contract review, MLS marketing, open houses, and market data,
      each available individually, with no full-service agent commitment required.
    </p>
    <p class="mt-4 text-stone-600">
      Unlike hiring an attorney, a flat-fee MLS company, and a title company separately, Thomas
      offers contract help, MLS marketing, open houses, and market data from a single licensed
      agent — pick only what's needed, with no full-service commitment.
    </p>
  </section>

  <section class="bg-stone-50 py-16">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="font-heading text-2xl text-brand">The typical FSBO route vs. one agent</h2>
      <div class="mt-6 overflow-x-auto rounded-lg border border-stone-200 bg-white">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead>
            <tr class="border-b border-stone-200 bg-stone-100 text-stone-900">
              <th scope="col" class="px-4 py-3 font-semibold">Need</th>
              <th scope="col" class="px-4 py-3 font-semibold">Typical FSBO route</th>
              <th scope="col" class="px-4 py-3 font-semibold">With Thomas</th>
            </tr>
          </thead>
          <tbody>
            {
              comparisonRows.map((row) => (
                <tr class="border-b border-stone-100 align-top last:border-0">
                  <th scope="row" class="px-4 py-3 font-medium text-stone-900">
                    {row.need}
                  </th>
                  <td class="px-4 py-3 text-stone-600">{row.typical}</td>
                  <td class="px-4 py-3 text-stone-600">{row.withThomas}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <h2 class="font-heading text-2xl text-brand">Common questions</h2>
    <div class="mt-8 space-y-8">
      {
        fsboFaqs.map((item) => (
          <div>
            <h3 class="font-semibold text-stone-900">{item.q}</h3>
            <p class="mt-2 text-stone-600">{item.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-gold/10 py-16">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="font-heading text-2xl text-brand">Not sure where to start? Talk it through first</h2>
      <p class="mt-4 text-stone-600">
        Before spending anything, you can book a free For Sale By Owner consultation. Thomas
        spends 20 to 30 minutes with you on a Google Meet video call explaining the work behind a sale or purchase without an agent,
        including listing marketing, the contract paperwork and where people commonly run into
        trouble, open house logistics, and how to price the property. Some FSBO sellers then go
        solo; others hire him for just one or two pieces. Either way, there's no obligation.
      </p>
      <p class="mt-3 text-sm text-stone-500">
        Thomas is not an attorney. For legal questions, a real estate attorney is the right person to ask.
      </p>
      <a href="/get-started" class="mt-4 inline-block font-medium text-gold-dark">
        Book your free For Sale By Owner consultation &rarr;
      </a>
    </div>
  </section>

  <section class="bg-brand py-16 text-white">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="font-heading text-2xl">Ready to see pricing and pick what you need?</h2>
      <p class="mt-2 text-stone-200">
        See all four services and their flat-fee pricing, or skip straight to telling Thomas
        what you're looking for.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/what-i-offer" class="text-sm font-medium text-gold">See What I Offer &rarr;</a>
        <a href="/get-started" class="text-sm font-medium text-gold">Get Started &rarr;</a>
      </div>
    </div>
  </section>
</Layout>
