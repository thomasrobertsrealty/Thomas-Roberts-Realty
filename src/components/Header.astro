---
import { NAV_LINKS, SITE } from '../lib/site.js'
const currentPath = Astro.url.pathname
---

<header class="border-b border-stone-200 bg-white">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="font-heading text-lg font-semibold tracking-tight text-brand">
      {SITE.agentName}
      <span class="block font-body text-xs font-normal uppercase tracking-wide text-stone-500">
        {SITE.brokerage}
      </span>
    </a>
    <nav aria-label="Primary" class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      {
        NAV_LINKS.map((link) => {
          const active = currentPath === link.href
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class={`transition-colors hover:text-gold-dark ${
                active ? 'font-semibold text-brand' : 'text-stone-600'
              }`}
            >
              {link.label}
            </a>
          )
        })
      }
      <a
        href="/contact"
        class="rounded-full bg-gold px-4 py-2 text-sm font-semibold text-brand-dark transition-colors hover:bg-gold-dark"
      >
        Contact
      </a>
    </nav>
  </div>
</header>
