---
import { SITE, NAV_LINKS } from '../lib/site.js'
const year = new Date().getFullYear()
---

<footer class="mt-16 bg-brand text-stone-200">
  <div class="mx-auto grid max-w-5xl gap-8 px-6 py-10 text-sm sm:grid-cols-3">
    <div>
      <p class="font-heading font-semibold text-white">{SITE.agentName}</p>
      <p>{SITE.brokerage}</p>
      <p class="mt-2 text-stone-400">{SITE.licenseNumber}</p>
    </div>
    <div>
      <p class="font-heading font-semibold text-white">Contact</p>
      <p><a href={`tel:${SITE.phoneRaw}`} class="hover:text-gold">{SITE.phone}</a></p>
      <p><a href={`mailto:${SITE.email}`} class="hover:text-gold">{SITE.email}</a></p>
    </div>
    <div>
      <p class="font-heading font-semibold text-white">Site</p>
      <ul class="mt-1 space-y-1">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="hover:text-gold">
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/get-started" class="hover:text-gold">
            Get Started
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 px-6 py-4 text-center text-xs text-stone-400">
    &copy; {year} {SITE.agentName} &mdash; {SITE.brokerage}. Serving Southeast Idaho.
  </div>
</footer>
